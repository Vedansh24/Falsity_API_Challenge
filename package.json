{
  "name": "falsity-api-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Phase 1 backend built with Fastify and TypeScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/helmet": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^8.13.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.11.1",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^11.0.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "prisma": "^6.6.0",
    "prom-client": "^15.1.3",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "redis": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "^4.1.5",
    "supertest": "^7.2.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  }
}
